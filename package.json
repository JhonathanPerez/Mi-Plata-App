{
  "name": "mi-plata",
  "private": true,
  "version": "1.1.1",
  "description": "Mi Plata: control de gastos personales para Colombia (React + Capacitor + SQLite, 100 % offline).",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "postinstall": "node scripts/copy-sql-wasm.mjs",
    "prepare": "node scripts/setup-husky.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:add": "cap add android && node scripts/harden-android.mjs && node scripts/apply-android-icon.mjs && node scripts/apply-android-native.mjs && node scripts/sync-android-version.mjs",
    "android:sync": "npm run build && node scripts/apply-android-native.mjs && node scripts/sync-android-version.mjs && cap sync android",
    "android:run": "npm run android:sync && cap run android",
    "android:open": "npm run android:sync && cap open android",
    "android:icon": "node scripts/apply-android-icon.mjs",
    "android:native": "node scripts/apply-android-native.mjs",
    "android:sign": "node scripts/apply-android-signing.mjs",
    "android:version": "node scripts/sync-android-version.mjs",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.0.0",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/figtree": "^5.1.0",
    "@number-flow/react": "^0.5.9",
    "@phosphor-icons/react": "^2.1.7",
    "@use-gesture/react": "^10.3.1",
    "exceljs": "^4.4.0",
    "jeep-sqlite": "^2.8.0",
    "motion": "^12.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
